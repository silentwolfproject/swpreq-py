include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml
include MANIFEST.in

recursive-include swpreq *.py
recursive-include swpreq *.pyi
recursive-include swpreq/lib *.dll
recursive-include swpreq/lib *.so
recursive-include swpreq/lib *.dylib

global-exclude __pycache__
global-exclude *.py[co]
global-exclude *.so.tmp
global-exclude *.egg-info